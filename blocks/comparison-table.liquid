{% comment %}
  Comparison Table Block - 产品对比表格组件
  用于展示产品与竞品的对比
{% endcomment %}

{%- liquid
  assign title = block.settings.title
  assign style = block.settings.style
  assign alignment = block.settings.alignment
  assign spec_label = block.settings.spec_label
  assign our_label = block.settings.our_label
  assign competitor_label = block.settings.competitor_label
  assign highlight_our = block.settings.highlight_our
  assign show_icons = block.settings.show_icons
-%}

<div 
  class="comparison-table-block comparison-table-block--{{ alignment }}" 
  {{ block.shopify_attributes }}
>
  {%- if title != blank -%}
    <h3 class="comparison-table-block__title">{{ title }}</h3>
  {%- endif -%}

  <div class="comparison-table-block__scroll">
    <table class="comparison-table-block__table comparison-table-block__table--{{ style }}">
      <thead>
        <tr>
          <th>{{ spec_label | default: 'Feature' }}</th>
          <th class="comparison-table-block__our">
            {%- if show_icons -%}
              <span class="comparison-table-block__check">{% render 'icon', name: 'check' %}</span>
            {%- endif -%}
            {{ our_label | default: 'Our Product' }}
          </th>
          <th>{{ competitor_label | default: 'Others' }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for i in (1..8) -%}
          {%- assign spec = 'spec_' | append: i -%}
          {%- assign our_value = 'our_value_' | append: i -%}
          {%- assign competitor_value = 'competitor_value_' | append: i -%}
          {%- assign is_good = 'our_good_' | append: i -%}
          
          {%- if block.settings[spec] != blank -%}
            <tr>
              <td>{{ block.settings[spec] }}</td>
              <td class="comparison-table-block__our{% if highlight_our %} comparison-table-block__our--highlight{% endif %}">
                {%- if show_icons and block.settings[is_good] == true -%}
                  <span class="comparison-table-block__icon comparison-table-block__icon--good">
                    {% render 'icon', name: 'check' %}
                  </span>
                {%- elsif show_icons and block.settings[is_good] == false -%}
                  <span class="comparison-table-block__icon comparison-table-block__icon--bad">
                    {% render 'icon', name: 'x' %}
                  </span>
                {%- endif -%}
                {{ block.settings[our_value] }}
              </td>
              <td>{{ block.settings[competitor_value] }}</td>
            </tr>
          {%- endif -%}
        {%- endfor -%}
      </tbody>
    </table>
  </div>
</div>

<style>
  .comparison-table-block { width: 100%; }
  .comparison-table-block--left { text-align: left; }
  .comparison-table-block--center { text-align: center; }
  .comparison-table-block--right { text-align: right; }

  .comparison-table-block__title {
    margin0 2rem: 0 ;
    font-size: 2.4rem;
    font-weight: 700;
    color: rgb(var(--color-text));
  }

  .comparison-table-block__scroll {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid rgb(var(--color-border));
  }

  .comparison-table-block__table {
    width: 100%;
    min-width: 500px;
    border-collapse: collapse;
    background: rgb(var(--color-background));
  }

  .comparison-table-block__table th,
  .comparison-table-block__table td {
    padding: 1.4rem 1.5rem;
    text-align: center;
    border-bottom: 1px solid rgb(var(--color-border));
  }

  .comparison-table-block__table th {
    font-weight: 700;
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgb(var(--color-background-secondary));
    color: rgb(var(--color-text));
  }

  .comparison-table-block__table th:first-child,
  .comparison-table-block__table td:first-child {
    text-align: left;
    font-weight: 600;
    color: rgba(var(--color-text), 0.8);
  }

  .comparison-table-block__our {
    font-weight: 700;
    color: rgb(var(--color-accent));
  }

  .comparison-table-block__our--highlight {
    background: rgba(var(--color-accent), 0.08);
  }

  .comparison-table-block__table tbody tr:hover {
    background: rgba(var(--color-text), 0.02);
  }

  /* Icons */
  .comparison-table-block__icon {
    display: inline-flex;
    margin-right: 0.5rem;
    vertical-align: middle;
  }

  .comparison-table-block__icon svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .comparison-table-block__icon--good {
    color: rgb(34, 197, 94);
  }

  .comparison-table-block__icon--bad {
    color: rgb(239, 68, 68);
  }

  /* Style - Striped */
  .comparison-table-block__table--striped tbody tr:nth-child(odd) {
    background: rgba(var(--color-text), 0.02);
  }

  /* Style - Modern */
  .comparison-table-block__table--modern {
    border: none;
    border-radius: 16px;
    overflow: hidden;
  }

  .comparison-table-block__table--modern .comparison-table-block__our--highlight {
    background: linear-gradient(90deg, rgba(var(--color-accent), 0.1) 0%, rgba(var(--color-accent), 0.05) 100%);
  }

  @media (max-width: 749px) {
    .comparison-table-block__title { font-size: 2rem; }
    .comparison-table-block__scroll { border-radius: 8px; }
  }
</style>

{% schema %}
{
  "name": "Comparison Table",
  "class": "comparison-table-block",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "title", "label": "Title", "default": "Why Choose Us" },
    { "type": "text", "id": "spec_label", "label": "Feature Column Label", "default": "Feature" },
    { "type": "text", "id": "our_label", "label": "Our Product Label", "default": "Our Product" },
    { "type": "text", "id": "competitor_label", "label": "Competitor Label", "default": "Others" },
    { "type": "header", "content": "Style" },
    { "type": "select", "id": "style", "label": "Style", "options": [
      { "value": "default", "label": "Default" },
      { "value": "striped", "label": "Striped" },
      { "value": "modern", "label": "Modern" }
    ], "default": "default" },
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ], "default": "center" },
    { "type": "checkbox", "id": "highlight_our", "label": "Highlight our product column", "default": true },
    { "type": "checkbox", "id": "show_icons", "label": "Show check/X icons", "default": true },
    { "type": "header", "content": "Comparison Rows (8 max)" },
    { "type": "text", "id": "spec_1", "label": "Row 1 - Feature" },
    { "type": "text", "id": "our_value_1", "label": "Row 1 - Our Value", "default": "✓ Premium Quality" },
    { "type": "text", "id": "competitor_value_1", "label": "Row 1 - Competitor Value", "default": "✗ Lower Quality" },
    { "type": "checkbox", "id": "our_good_1", "label": "Row 1 - Our is better", "default": true },
    
    { "type": "text", "id": "spec_2", "label": "Row 2 - Feature" },
    { "type": "text", "id": "our_value_2", "label": "Row 2 - Our Value", "default": "✓ Free Shipping" },
    { "type": "text", "id": "competitor_value_2", "label": "Row 2 - Competitor Value", "default": "✗ Extra Fees" },
    { "type": "checkbox", "id": "our_good_2", "label": "Row 2 - Our is better", "default": true },

    { "type": "text", "id": "spec_3", "label": "Row 3 - Feature" },
    { "type": "text", "id": "our_value_3", "label": "Row 3 - Our Value", "default": "✓ 30-Day Returns" },
    { "type": "text", "id": "competitor_value_3", "label": "Row 3 - Competitor Value", "default": "✗ No Returns" },
    { "type": "checkbox", "id": "our_good_3", "label": "Row 3 - Our is better", "default": true },

    { "type": "text", "id": "spec_4", "label": "Row 4 - Feature" },
    { "type": "text", "id": "our_value_4", "label": "Row 4 - Our Value" },
    { "type": "text", "id": "competitor_value_4", "label": "Row 4 - Competitor Value" },

    { "type": "text", "id": "spec_5", "label": "Row 5 - Feature" },
    { "type": "text", "id": "our_value_5", "label": "Row 5 - Our Value" },
    { "type": "text", "id": "competitor_value_5", "label": "Row 5 - Competitor Value" },

    { "type": "text", "id": "spec_6", "label": "Row 6 - Feature" },
    { "type": "text", "id": "our_value_6", "label": "Row 6 - Our Value" },
    { "type": "text", "id": "competitor_value_6", "label": "Row 6 - Competitor Value" },

    { "type": "text", "id": "spec_7", "label": "Row 7 - Feature" },
    { "type": "text", "id": "our_value_7", "label": "Row 7 - Our Value" },
    { "type": "text", "id": "competitor_value_7", "label": "Row 7 - Competitor Value" },

    { "type": "text", "id": "spec_8", "label": "Row 8 - Feature" },
    { "type": "text", "id": "our_value_8", "label": "Row 8 - Our Value" },
    { "type": "text", "id": "competitor_value_8", "label": "Row 8 - Competitor Value" }
  ]
}
{% endschema %}
