{% comment %}
  Accordion Block - 手风琴/折叠面板组件
  支持图标、动画和多种样式
{% endcomment %}

{%- liquid
  assign heading = block.settings.heading
  assign content = block.settings.content
  assign open_by_default = block.settings.open_by_default
  assign icon = block.settings.icon
  assign icon_position = block.settings.icon_position
  assign style = block.settings.style
  assign size = block.settings.size
-%}

<details 
  class="accordion-block accordion-block--{{ style }} accordion-block--{{ size }}{% if open_by_default %} accordion-block--open{% endif %}" 
  {{ block.shopify_attributes }}
  {% if open_by_default %}open{% endif %}
>
  <summary class="accordion-block__summary">
    <span class="accordion-block__heading">
      {%- if icon != 'none' -%}
        <span class="accordion-block__icon">
          {% render 'icon', name: icon %}
        </span>
      {%- endif -%}
      <span class="accordion-block__title">{{ heading }}</span>
    </span>
    
    <span class="accordion-block__chevron" {% if icon_position == 'left' %}style="order: -1"{% endif %}>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </span>
  </summary>
  
  <div class="accordion-block__content">
    <div class="accordion-block__inner rte">
      {{ content }}
    </div>
  </div>
</details>

<style>
  .accordion-block {
    border-radius: var(--accordion-radius, 8px);
    overflow: hidden;
    margin-bottom: 1rem;
  }

  /* Style - Default */
  .accordion-block--default {
    border: 1px solid rgb(var(--color-border));
    background: rgb(var(--color-background));
  }

  /* Style - Filled */
  .accordion-block--filled {
    border: none;
    background: rgb(var(--color-background-secondary));
  }

  /* Style - Minimal */
  .accordion-block--minimal {
    border: none;
    background: transparent;
    border-bottom: 1px solid rgb(var(--color-border));
    border-radius: 0;
  }

  /* Summary */
  .accordion-block__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.6rem 2rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: background-color var(--duration-default) ease;
  }

  .accordion-block__summary::-webkit-details-marker {
    display: none;
  }

  .accordion-block--default .accordion-block__summary:hover,
  .accordion-block--filled .accordion-block__summary:hover {
    background: rgba(var(--color-text), 0.03);
  }

  /* Heading */
  .accordion-block__heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
  }

  .accordion-block__icon {
    display: flex;
    align-items: center;
    color: rgb(var(--color-accent));
  }

  .accordion-block__icon svg {
    width: 2rem;
    height: 2rem;
  }

  .accordion-block__title {
    font-weight: var(--accordion-font-weight, 600);
  }

  /* Size */
  .accordion-block--small .accordion-block__summary {
    padding: 1.2rem 1.6rem;
  }

  .accordion-block--small .accordion-block__title {
    font-size: 1.4rem;
  }

  .accordion-block--medium .accordion-block__title {
    font-size: 1.6rem;
  }

  .accordion-block--large .accordion-block__summary {
    padding: 2rem 2.4rem;
  }

  .accordion-block--large .accordion-block__title {
    font-size: 1.8rem;
  }

  /* Chevron */
  .accordion-block__chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(var(--color-text));
    opacity: 0.5;
    transition: transform var(--duration-default) ease;
    flex-shrink: 0;
    margin-left: 1rem;
  }

  .accordion-block__chevron svg {
    width: 2rem;
    height: 2rem;
  }

  .accordion-block[open] .accordion-block__chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* Content */
  .accordion-block__content {
    overflow: hidden;
    animation: accordion-open 0.3s ease;
  }

  .accordion-block__inner {
    padding: 0 2rem 2rem;
    color: rgba(var(--color-text), 0.8);
    line-height: 1.7;
  }

  .accordion-block--small .accordion-block__inner {
    padding: 0 1.6rem 1.6rem;
    font-size: 1.4rem;
  }

  .accordion-block--large .accordion-block__inner {
    padding: 0 2.4rem 2.4rem;
    font-size: 1.7rem;
  }

  /* Animation */
  @keyframes accordion-open {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Focus states */
  .accordion-block__summary:focus-visible {
    outline: 2px solid rgb(var(--color-accent));
    outline-offset: -2px;
  }

  /* RTL Support */
  .accordion-block[open] .accordion-block__chevron {
    transform: rotate(180deg);
  }

  [dir="rtl"] .accordion-block[open] .accordion-block__chevron {
    transform: rotate(-180deg);
  }

  /* Mobile */
  @media (max-width: 749px) {
    .accordion-block__summary {
      padding: 1.4rem 1.6rem;
    }

    .accordion-block__inner {
      padding: 0 1.6rem 1.6rem;
    }
  }
</style>

<script>
  document.querySelectorAll('.accordion-block').forEach(accordion => {
    const summary = accordion.querySelector('.accordion-block__summary');
    
    summary.addEventListener('click', (e) => {
      e.preventDefault();
      
      const isOpen = accordion.hasAttribute('open');
      
      if (isOpen) {
        accordion.removeAttribute('open');
        accordion.classList.remove('accordion-block--open');
      } else {
        accordion.setAttribute('open', '');
        accordion.classList.add('accordion-block--open');
      }
    });
  });
</script>

{% schema %}
{
  "name": "Accordion",
  "class": "accordion-block",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Accordion Title"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add your content here. This is a great place to answer common questions or provide additional information.</p>"
    },
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "question", "label": "Question" },
        { "value": "info", "label": "Info" },
        { "value": "check", "label": "Check" },
        { "value": "warning", "label": "Warning" },
        { "value": "gift", "label": "Gift" },
        { "value": "truck", "label": "Shipping" },
        { "value": "shield", "label": "Secure" },
        { "value": "support", "label": "Support" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon Position",
      "options": [
        { "value": "left", "label": "Left of title" },
        { "value": "right", "label": "Right of title" }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "default", "label": "Default (Bordered)" },
        { "value": "filled", "label": "Filled Background" },
        { "value": "minimal", "label": "Minimal (Line)" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    }
  ]
}
{% endschema %}
