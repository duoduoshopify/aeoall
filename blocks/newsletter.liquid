{% comment %}
  Newsletter Block - 邮件订阅组件
  支持多种样式、图标和成功消息
{% endcomment %}

{%- liquid
  assign heading = block.settings.heading
  assign subheading = block.settings.subheading
  assign button_text = block.settings.button_text
  assign placeholder = block.settings.placeholder
  assign style = block.settings.style
  assign alignment = block.settings.alignment
  assign show_icon = block.settings.show_icon
  assign icon = block.settings.icon
  assign show_privacy = block.settings.show_privacy
-%}

<div 
  class="newsletter-block newsletter-block--{{ alignment }} newsletter-block--{{ style }}" 
  {{ block.shopify_attributes }}
>
  <div class="newsletter-block__content">
    {%- if show_icon and icon != 'none' -%}
      <div class="newsletter-block__icon">
        {% render 'icon', name: icon %}
      </div>
    {%- endif -%}

    {%- if heading != blank -%}
      <h3 class="newsletter-block__heading">{{ heading }}</h3>
    {%- endif -%}

    {%- if subheading != blank -%}
      <p class="newsletter-block__subheading">{{ subheading }}</p>
    {%- endif -%}
  </div>

  {%- form 'customer', id: 'newsletter-' | append: section.id, class: 'newsletter-block__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    
    <div class="newsletter-block__inputs">
      <div class="newsletter-block__input-wrapper">
        <input
          type="email"
          name="contact[email]"
          id="newsletter-email-{{ section.id }}"
          class="newsletter-block__input"
          value="{{ form.email }}"
          placeholder="{{ placeholder | default: 'Enter your email' }}"
          aria-label="{{ placeholder | default: 'Email address' }}"
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="newsletter-error-{{ section.id }}"
          {% endif %}
          required
        >
      </div>

      <button 
        type="submit" 
        class="newsletter-block__button"
        name="commit"
        aria-label="{{ button_text | default: 'Subscribe' }}"
      >
        {{ button_text | default: 'Subscribe' }}
      </button>
    </div>

    {%- if form.errors -%}
      <div class="newsletter-block__error" id="newsletter-error-{{ section.id }}">
        {% render 'icon', name: 'x' %}
        {{ form.errors.translated_fields['email'] | capitalize }} - {{ form.errors.messages['email'] }}.
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? -%}
      <div class="newsletter-block__success" id="newsletter-success-{{ section.id }}">
        {% render 'icon', name: 'check' %}
        {{ 'newsletter.success' | t }}
      </div>
    {%- endif -%}
  {%- endform -%}

  {%- if show_privacy -%}
    <p class="newsletter-block__privacy">
      {{ 'newsletter.privacy_notice' | t | default: 'We respect your privacy. Unsubscribe at any time.' }}
    </p>
  {%- endif -%}
</div>

<style>
  .newsletter-block {
    width: 100%;
  }

  .newsletter-block--left { text-align: left; }
  .newsletter-block--center { text-align: center; }
  .newsletter-block--right { text-align: right; }

  /* Content */
  .newsletter-block__content {
    margin-bottom: 2rem;
  }

  .newsletter-block__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 6rem;
    height: 6rem;
    margin-bottom: 1.5rem;
    background: rgba(var(--color-accent), 0.1);
    border-radius: 50%;
    color: rgb(var(--color-accent));
  }

  .newsletter-block__icon svg {
    width: 2.8rem;
    height: 2.8rem;
  }

  .newsletter-block__heading {
    margin: 0 0 1rem;
    font-size: 2.4rem;
    font-weight: 700;
    color: rgb(var(--color-text));
  }

  .newsletter-block__subheading {
    margin: 0;
    font-size: 1.5rem;
    color: rgba(var(--color-text), 0.7);
    line-height: 1.6;
  }

  /* Form */
  .newsletter-block__inputs {
    display: flex;
    gap: 1rem;
    max-width: 500px;
  }

  .newsletter-block--left .newsletter-block__inputs { justify-content: flex-start; }
  .newsletter-block--center .newsletter-block__inputs { margin: 0 auto; }
  .newsletter-block--right .newsletter-block__inputs { margin-left: auto; }

  .newsletter-block__input-wrapper {
    flex: 1;
  }

  .newsletter-block__input {
    width: 100%;
    padding: 1.4rem 1.6rem;
    font-size: 1.5rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: var(--buttons-radius, 50px);
    background: rgb(var(--color-background));
    color: rgb(var(--color-text));
    transition: border-color var(--duration-default) ease;
  }

  .newsletter-block__input::placeholder {
    color: rgba(var(--color-text), 0.4);
  }

  .newsletter-block__input:focus {
    outline: none;
    border-color: rgb(var(--color-accent));
  }

  .newsletter-block__button {
    flex-shrink: 0;
    padding: 1.4rem 2.4rem;
    font-size: 1.5rem;
    font-weight: 700;
    border: none;
    border-radius: var(--buttons-radius, 50px);
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    cursor: pointer;
    transition: all var(--duration-default) ease;
    white-space: nowrap;
  }

  .newsletter-block__button:hover {
    background: rgb(var(--color-button-hover));
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(var(--color-button), 0.3);
  }

  /* Style - Minimal */
  .newsletter-block--minimal .newsletter-block__input {
    border-radius: 8px;
  }

  .newsletter-block--minimal .newsletter-block__button {
    border-radius: 8px;
  }

  /* Style - Underline */
  .newsletter-block--underline .newsletter-block__input {
    border: none;
    border-bottom: 2px solid rgb(var(--color-border));
    border-radius: 0;
    padding-left: 0;
    padding-right: 0;
  }

  .newsletter-block--underline .newsletter-block__input:focus {
    border-bottom-color: rgb(var(--color-accent));
  }

  /* Style - Card */
  .newsletter-block--card {
    padding: 3rem;
    background: rgb(var(--color-background-secondary));
    border-radius: 16px;
  }

  /* Error & Success */
  .newsletter-block__error,
  .newsletter-block__success {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 1.3rem;
  }

  .newsletter-block__error {
    color: rgb(239, 68, 68);
  }

  .newsletter-block__success {
    color: rgb(34, 197, 94);
  }

  .newsletter-block__error svg,
  .newsletter-block__success svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  /* Privacy */
  .newsletter-block__privacy {
    margin-top: 1.5rem;
    font-size: 1.2rem;
    color: rgba(var(--color-text), 0.5);
    line-height: 1.5;
  }

  /* Mobile */
  @media (max-width: 749px) {
    .newsletter-block__inputs {
      flex-direction: column;
    }

    .newsletter-block__heading {
      font-size: 2rem;
    }

    .newsletter-block__subheading {
      font-size: 1.4rem;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "class": "newsletter-block",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get the latest updates and exclusive offers straight to your inbox."
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "checkbox",
      "id": "show_privacy",
      "label": "Show privacy notice",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "default", "label": "Default (Rounded)" },
        { "value": "minimal", "label": "Minimal" },
        { "value": "underline", "label": "Underline" },
        { "value": "card", "label": "Card (Boxed)" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "email", "label": "Email" },
        { "value": "newsletter", "label": "Newsletter" },
        { "value": "mail", "label": "Mail" }
      ],
      "default": "email"
    }
  ]
}
{% endschema %}
