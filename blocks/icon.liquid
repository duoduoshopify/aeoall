{% comment %}
  Icon Block - 图标组件
  支持多种图标、对齐方式和动画效果
{% endcomment %}

{%- liquid
  assign icon = block.settings.icon
  assign size = block.settings.size
  assign color = block.settings.color
  assign alignment = block.settings.alignment
  assign link = block.settings.link
  assign enable_hover = block.settings.enable_hover
  assign enable_animation = block.settings.enable_animation
  assign icon_only = block.settings.icon_only
  assign label = block.settings.label
-%}

{%- if icon != 'none' -%}
  <div 
    class="icon-block icon-block--{{ alignment }} icon-block--{{ size }} icon-block--{{ color }}{% if enable_hover %} icon-block--hover{% endif %}{% if enable_animation %} icon-block--animated{% endif %}" 
    {{ block.shopify_attributes }}
  >
    {%- if link != blank -%}
      <a href="{{ link }}" class="icon-block__link" {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}>
    {%- endif -%}
    
    <div class="icon-block__wrapper">
      <span class="icon-block__icon">
        {% render 'icon', name: icon %}
      </span>
      
      {%- if label != blank and icon_only == false -%}
        <span class="icon-block__label">{{ label }}</span>
      {%- endif -%}
    </div>
    
    {%- if link != blank -%}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

<style>
  .icon-block {
    display: flex;
    width: auto;
  }

  .icon-block--left { justify-content: flex-start; }
  .icon-block--center { justify-content: center; }
  .icon-block--right { justify-content: flex-end; }

  .icon-block__link {
    display: flex;
    text-decoration: none;
    color: inherit;
  }

  .icon-block__wrapper {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .icon-block__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--duration-default) ease;
  }

  /* Size */
  .icon-block--small .icon-block__icon svg {
    width: 2rem;
    height: 2rem;
  }

  .icon-block--medium .icon-block__icon svg {
    width: 2.4rem;
    height: 2.4rem;
  }

  .icon-block--large .icon-block__icon svg {
    width: 3.2rem;
    height: 3.2rem;
  }

  .icon-block--xlarge .icon-block__icon svg {
    width: 4.8rem;
    height: 4.8rem;
  }

  /* Color */
  .icon-block--default .icon-block__icon {
    color: rgb(var(--color-text));
  }

  .icon-block--accent .icon-block__icon {
    color: rgb(var(--color-accent));
  }

  .icon-block--primary .icon-block__icon {
    color: rgb(var(--color-button));
  }

  .icon-block--secondary .icon-block__icon {
    color: rgba(var(--color-text), 0.6);
  }

  /* Circular Background */
  .icon-block--circle .icon-block__wrapper {
    padding: 1rem;
    border-radius: 50%;
    background: rgba(var(--color-text), 0.05);
  }

  .icon-block--circle-accent .icon-block__wrapper {
    padding: 1rem;
    border-radius: 50%;
    background: rgba(var(--color-accent), 0.1);
  }

  .icon-block--circle-accent .icon-block__icon {
    color: rgb(var(--color-accent));
  }

  /* Label */
  .icon-block__label {
    font-weight: 600;
    font-size: 1.4rem;
  }

  /* Hover Effects */
  .icon-block--hover .icon-block__link:hover .icon-block__icon {
    transform: scale(1.1);
  }

  .icon-block--hover.icon-block--accent .icon-block__link:hover .icon-block__icon {
    color: rgb(var(--color-button));
  }

  /* Animation */
  .icon-block--animated .icon-block__icon {
    animation: icon-bounce 2s ease-in-out infinite;
  }

  @keyframes icon-bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  /* Spin Animation */
  .icon-block--spin .icon-block__icon {
    animation: icon-spin 3s linear infinite;
  }

  @keyframes icon-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Pulse */
  .icon-block--pulse .icon-block__icon {
    animation: icon-pulse 2s ease-in-out infinite;
  }

  @keyframes icon-pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.7;
      transform: scale(0.95);
    }
  }

  /* Link arrow for external links */
  .icon-block__external-icon {
    opacity: 0;
    transition: opacity var(--duration-default) ease, transform var(--duration-default) ease;
  }

  .icon-block__link:hover .icon-block__external-icon {
    opacity: 1;
    transform: translateX(3px);
  }

  /* Mobile */
  @media (max-width: 749px) {
    .icon-block--large .icon-block__icon svg { width: 2.4rem; height: 2.4rem; }
    .icon-block--xlarge .icon-block__icon svg { width: 3.6rem; height: 3.6rem; }
  }
</style>

{% schema %}
{
  "name": "Icon",
  "class": "icon-block",
  "settings": [
    {
      "type": "header",
      "content": "Icon Settings"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "arrow-right", "label": "Arrow Right" },
        { "value": "arrow-left", "label": "Arrow Left" },
        { "value": "arrow-up", "label": "Arrow Up" },
        { "value": "arrow-down", "label": "Arrow Down" },
        { "value": "cart", "label": "Cart" },
        { "value": "search", "label": "Search" },
        { "value": "user", "label": "User" },
        { "value": "heart", "label": "Heart" },
        { "value": "star", "label": "Star" },
        { "value": "check", "label": "Check" },
        { "value": "x", "label": "Close" },
        { "value": "menu", "label": "Menu" },
        { "value": "filter", "label": "Filter" },
        { "value": "play", "label": "Play" },
        { "value": "pause", "label": "Pause" },
        { "value": "email", "label": "Email" },
        { "value": "phone", "label": "Phone" },
        { "value": "location", "label": "Location" },
        { "value": "clock", "label": "Clock" },
        { "value": "truck", "label": "Shipping" },
        { "value": "shield", "label": "Secure" },
        { "value": "gift", "label": "Gift" },
        { "value": "fire", "label": "Fire/Hot" },
        { "value": "sun", "label": "Sun" },
        { "value": "moon", "label": "Moon" },
        { "value": "tool", "label": "Settings" },
        { "value": "support", "label": "Support" }
      ],
      "default": "check"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label Text",
      "info": "Optional text next to icon"
    },
    {
      "type": "checkbox",
      "id": "icon_only",
      "label": "Icon only (hide label)",
      "default": false
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "Extra Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "color",
      "label": "Color",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "accent", "label": "Accent" },
        { "value": "primary", "label": "Primary (Button Color)" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "circle", "label": "Circle Background" },
        { "value": "circle-accent", "label": "Circle with Accent" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_hover",
      "label": "Enable hover effect",
      "default": false
    },
    {
      "type": "select",
      "id": "enable_animation",
      "label": "Animation",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "bounce", "label": "Bounce" },
        { "value": "spin", "label": "Spin" },
        { "value": "pulse", "label": "Pulse" }
      ],
      "default": "none"
    }
  ]
}
{% endschema %}
