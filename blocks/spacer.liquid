{% comment %}
  Spacer Block - 间距组件
  支持桌面和移动端的独立间距设置
{% endcomment %}

{%- liquid
  assign height = block.settings.height
  assign height_mobile = block.settings.height_mobile
  assign show_line = block.settings.show_line
  assign collapse_on_mobile = block.settings.collapse_on_mobile
-%}

<div 
  class="spacer-block{% if show_line %} spacer-block--line{% endif %}{% if collapse_on_mobile %} spacer-block--collapse{% endif %}" 
  style="
    --spacer-height: {{ height }}px;
    --spacer-height-mobile: {{ height_mobile }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- if show_line -%}
    <div class="spacer-block__line"></div>
  {%- endif -%}
</div>

<style>
  .spacer-block {
    width: 100%;
    height: var(--spacer-height);
    position: relative;
  }

  /* Show line option */
  .spacer-block--line .spacer-block__line {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 1px;
    height: 40%;
    background: rgba(var(--color-border), 0.3);
  }

  /* Collapse on mobile */
  .spacer-block--collapse {
    height: var(--spacer-height-mobile);
  }

  /* Mobile */
  @media (max-width: 749px) {
    .spacer-block:not(.spacer-block--collapse) {
      height: var(--spacer-height-mobile);
    }
  }
</style>

{% schema %}
{
  "name": "Spacer",
  "settings": [
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "checkbox",
      "id": "show_line",
      "label": "Show center line (for development)",
      "default": false,
      "info": "Visual guide to see the spacer"
    },
    {
      "type": "checkbox",
      "id": "collapse_on_mobile",
      "label": "Use mobile height on all devices",
      "default": false
    }
  ]
}
{% endschema %}
